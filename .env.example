AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_API_URL=
OPENAI_MODEL_NAME=
OPENAI_DISABLE_THINKING=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase Admin SDK — OPTIONAL. Used only to verify Firebase ID tokens for
# the app's session cookie (app/api/auth/session/route.ts). On Cloud Run this
# is unnecessary (the service's own service account is used via Application
# Default Credentials); Firebase Auth sign-in and Firestore sync work fully
# without these three vars set. Get them from Firebase Console > Project
# settings > Service accounts > Generate new private key. Paste the private
# key with literal \n escapes (not real newlines) inside double quotes — see
# lib/firebase/admin.ts.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Automated reminder cron (app/api/cron/send-reminders) — REQUIRED for
# scheduled reminder emails; the interactive "send test email" button in
# Settings keeps working without it. Also requires FIREBASE_ADMIN_* above (or
# Application Default Credentials on Cloud Run) so the route can read
# per-user Gmail tokens and due words via the Admin SDK, and requires APP_URL
# to be set to the real deployed origin (there is no incoming request to read
# it from in a cron context — see lib/auth/google.ts resolveOrigin()).
# Generate with `openssl rand -hex 32`; Cloud Scheduler sends it back as the
# `x-cron-secret` header — see docs/status.md for the exact job command.
CRON_SECRET=
